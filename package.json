{
  "name": "bazar-e-pak-server",
  "version": "1.0.0",
  "description": "Production-ready REST API server for Bazar-e-Pak",
  "private": true,
  "type": "module",
  "author": {
    "name": "Red Phoniex"
  },
  "license": "MIT",
  "keywords": [
    "bazar-e-pak",
    "ecommerce",
    "rest-api",
    "express",
    "bun",
    "mongodb",
    "mongoose",
    "authentication",
    "authorization",
    "jwt"
  ],
  "scripts": {
    "dev": "bun --watch src/server.js",
    "build": "bun build src/server.js --outdir dist --target bun",
    "start": "bun run dist/server.js",
    "check": "bun --check src/server.js",
    "test": "bun test"
  },
  "dependencies": {
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "jose": "latest",
    "mongoose": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
